# Template for configuring local environment variables
# Copy this to create the .env file and docker-compose
# will pickup the values from the .env file.

# SAML SP's Signing Key
SAML_SP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"

# SAML SP's Certificate
SAML_SP_CERTIFICATE="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"

# Handle Configuration
UMD_HANDLE_SERVER_URL=
UMD_HANDLE_JWT_TOKEN=

# IP Manager Configuration
IP_MANAGER_SERVER_URL=

# Active Record Encryption (required for ApiToken encryption in v8.2+)
# Generate values with: rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# Set to 'true' only during ApiToken migration (supports reading unencrypted legacy tokens)
ACTIVE_RECORD_ENCRYPTION_MIGRATION=false

# Matomo Analytics configuration
MATOMO_ANALYTICS_URL=https://umd.matomo.cloud/
MATOMO_ANALYTICS_SITE_ID=
MATOMO_ANALYTICS_CDN_SRC= //cdn.matomo.cloud/umd.matomo.cloud/matomo.js
