<% if can?(:update_access_control, object) %>
<%= bootstrap_form_for object, html: { id: 'diarization_form' }  do |vid| %>
  <% if Settings.transcription.enabled && object.is_a?(Admin::Collection) %>
    <div class="card enable-diarization" data-testid="collection-enable-diarization-card">
      <div class="card-header">
        <h3 class="card-title">Speaker Diarization</h3>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <div class="form-check">
            <%= label_tag :diarization do %>
            <%= check_box_tag :diarization, '1', (diarization), data: { testid: 'diarization-enable-checkbox' }%>
            Label distinct speakers when transcribing this collection's items
            <% end %>
          </div>
        </div>
        <%= hidden_field_tag :save_field, "diarization" %>
        <%= submit_tag "Save Setting", class: "btn btn-primary", form: 'diarization_form', data:{testid: 'diarization-save-setting'} %>
      </div>
    </div>
  <% end %>
<% end %>

<%= bootstrap_form_for object, html: { id: 'diarization_max_speakers_form' }  do |vid| %>
  <% if diarization_enabled?(object) %>
    <div class="card diarization-max-speakers" data-testid="collection-diarization-max-speakers-card">
      <div class="card-header">
        <h3 class="card-title">Maximum speakers</h3>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label class="col-form-label" for="max_speakers">
            Upper bound on distinct speakers AWS Transcribe should try to identify (2-30)
          </label>
          <%= text_field_tag "max_speakers", max_speakers, class: 'form-control', data: { testid: 'diarization-max-speakers-input' } %>
        </div>
        <%= hidden_field_tag :save_field, "diarization_max_speakers" %>
        <%= submit_tag "Save Setting", class: "btn btn-primary", form: 'diarization_max_speakers_form', data:{testid: 'diarization-max-speakers-save-setting'} %>
      </div>
    </div>
  <% end %>
<% end %>

<% else %>

  <% if diarization_enabled?(object) %>
    <div class="card diarization-max-speakers">
      <div class="card-header">
        <h3 class="card-title">Speaker Diarization</h3>
      </div>
      <div class="card-body">
        <div class="mb-3">
          Speaker diarization is enabled, identifying up to <%= max_speakers %> speakers.
        </div>
      </div>
    </div>
  <% end %>
<% end %>
