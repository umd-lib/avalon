%>
<p id="notice"><%= notice %></p>
<p id="alert"><%= alert %></p>

<div class="container-md">
  <h1>Edit Caption Text</h1>
  <p>
    MasterFile: <%= link_to @presenter.master_file_id, @presenter.master_file_url %> &middot;
    MediaObject: <%= link_to @presenter.media_object_id, @presenter.media_object_url %> &middot;
    Language: <%= @presenter.language %>
  </p>
  <p>
    Only the text of each cue can be corrected here — timestamps aren't editable. For structural
    corrections (re-timing, adding/removing cues), use Replace on the review dashboard instead.
  </p>

  <%= form_with url: update_text_transcription_review_path(@supplemental_file), method: :post, local: true do %>
    <% @cue_editor.cues.each do |cue| %>
      <div class="mb-3">
        <div class="text-muted small">
          <%= cue.timing %><%= " (#{cue.identifier})" if cue.identifier.present? %>
        </div>
        <%= text_area_tag "cues[#{cue.index}]", cue.text, rows: [cue.text.lines.count, 2].max, class: 'form-control' %>
      </div>
    <% end %>

    <div class="mt-3">
      <%= submit_tag 'Save Changes', class: 'btn btn-primary' %>
      <%= link_to 'Approve', approve_transcription_review_path(@supplemental_file),
                  method: :post, class: 'btn btn-sm btn-outline',
                  data: { confirm: 'Approve this caption/transcript?' } %>
      <%= link_to 'Reject', reject_transcription_review_path(@supplemental_file),
                  method: :post, class: 'btn btn-sm btn-outline',
                  data: { confirm: 'Reject this caption/transcript?' } %>
      <%= link_to 'Cancel', transcription_reviews_path, class: 'btn btn-sm btn-outline' %>
    </div>
  <% end %>
</div>
